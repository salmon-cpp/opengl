{
    // All build logic lives in CMakeLists.txt; these tasks only call CMake.
    // Ctrl+Shift+B runs "Build", which configures first (a no-op once build/ exists).
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "windows": {
        "options": {
            "env": {
                // MSYS2 UCRT64 toolchain: gcc, cmake, ninja.
                "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
            }
        }
    },
    "tasks": [
        {
            "label": "Configure",
            "type": "process",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-G", "Ninja"],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build"],
            "dependsOn": "Configure",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}/build"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean rebuild",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build", "--clean-first"],
            "dependsOn": "Configure",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}/build"]
            },
            "group": "build"
        }
    ]
}
